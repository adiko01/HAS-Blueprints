blueprint:
  name: Fenstersteuerung für Raumheizungen mit Datumssperre
  description: >
    Schaltet alle Heizungen eines Raums aus, sobald mindestens
    ein Fenster geöffnet ist. Sind alle Fenster geschlossen,
    werden die Heizungen nur eingeschaltet, wenn keine
    zukünftige Datumssperre aktiv ist.
  domain: automation

  input:
    room_area:
      name: Raum
      description: Raum mit Fensterkontakten und Heizungen
      selector:
        area:

    date_helper:
      name: Optionaler Datumshelfer
      description: >
        Optionaler input_datetime-Helfer. Bei einem zukünftigen
        Datum wird das Einschalten der Heizung unterdrückt.
      default: ""
      selector:
        entity:
          filter:
            - domain: input_datetime

variables:
  room_area: !input room_area
  date_helper: !input date_helper

trigger:
  - platform: event
    event_type: state_changed

condition:
  - condition: template
    value_template: >
      {% set entity_id = trigger.event.data.entity_id %}
      {% set old = trigger.event.data.old_state %}
      {% set new = trigger.event.data.new_state %}
      {{
        old is not none
        and new is not none
        and entity_id in area_entities(room_area)
        and entity_id.startswith('binary_sensor.')
        and new.attributes.get('device_class') == 'window'
        and old.state != new.state
        and new.state in ['on', 'off']
      }}

action:
  - variables:
      room_windows: >
        {{ expand(area_entities(room_area))
           | selectattr('attributes.device_class', 'defined')
           | selectattr('attributes.device_class', 'equalto', 'window')
           | map(attribute='entity_id')
           | list }}
      room_heaters: >
        {{ area_entities(room_area)
           | select('match', '^climate\\.')
           | list }}

  - choose:
      # Mindestens ein Fenster ist offen: Heizung ausschalten
      - conditions:
          - condition: template
            value_template: >
              {{ expand(room_windows)
                 | selectattr('state', 'eq', 'on')
                 | list | count > 0 }}
        sequence:
          - condition: template
            value_template: "{{ room_heaters | count > 0 }}"
          - action: climate.turn_off
            target:
              entity_id: "{{ room_heaters }}"

      # Alle Fenster sind geschlossen und Datumssperre ist abgelaufen
      - conditions:
          - condition: template
            value_template: >
              {{
                room_windows | count > 0
                and
                (expand(room_windows)
                 | selectattr('state', 'eq', 'off')
                 | list | count) == (room_windows | count)
              }}
          - condition: template
            value_template: >
              {% if date_helper == '' %}
                true
              {% else %}
                {% set value = states(date_helper) %}
                {% if value in ['unknown', 'unavailable', ''] %}
                  true
                {% else %}
                  {{ as_timestamp(value, 0) <= as_timestamp(now()) }}
                {% endif %}
              {% endif %}
        sequence:
          - condition: template
            value_template: "{{ room_heaters | count > 0 }}"
          - action: climate.turn_on
            target:
              entity_id: "{{ room_heaters }}"

mode: queued
