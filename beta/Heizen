blueprint:
  name: Fenstersteuerung für Raumheizungen mit Datumssperre
  description: >
    Schaltet die Heizungen eines Raums beim Öffnen eines Fensters aus.
    Beim Schließen werden die Heizungen nur eingeschaltet, wenn kein
    zukünftiges Sperrdatum im Datumshelfer eingetragen ist.
  domain: automation

  input:
    room_area:
      name: Raum
      description: Raum mit Fensterkontakt und Heizungen
      selector:
        area:

    date_helper:
      name: Optionaler Datumshelfer
      description: >
        Optionaler input_datetime-Helfer. Liegt sein Datum in der
        Zukunft, wird das Einschalten beim Schließen des Fensters
        bis zum Erreichen des Datums unterdrückt.
      default: ""
      selector:
        entity:
          filter:
            - domain: input_datetime
          multiple: false

variables:
  room_area: !input room_area
  date_helper: !input date_helper

trigger:
  - platform: event
    event_type: state_changed

condition:
  - condition: template
    value_template: >
      {% set entity_id = trigger.event.data.entity_id %}
      {% set old = trigger.event.data.old_state %}
      {% set new = trigger.event.data.new_state %}
      {{
        old is not none
        and new is not none
        and entity_id in area_entities(room_area)
        and entity_id.startswith('binary_sensor.')
        and new.attributes.get('device_class') == 'window'
        and old.state != new.state
        and new.state in ['on', 'off']
      }}

action:
  - choose:
      # Fenster geöffnet: Heizungen ausschalten
      - conditions:
          - condition: template
            value_template: >
              {{ trigger.event.data.new_state.state == 'on' }}
        sequence:
          - action: climate.turn_off
            target:
              entity_id: >
                {{ area_entities(room_area)
                   | select('match', '^climate\\.')
                   | list }}

      # Fenster geschlossen: Nur ohne zukünftiges Sperrdatum einschalten
      - conditions:
          - condition: template
            value_template: >
              {{ trigger.event.data.new_state.state == 'off' }}
          - condition: template
            value_template: >
              {% set helper = date_helper %}
              {% if helper == '' %}
                true
              {% else %}
                {% set value = states(helper) %}
                {% if value in ['unknown', 'unavailable', ''] %}
                  true
                {% else %}
                  {{ as_timestamp(value, 0) <= as_timestamp(now()) }}
                {% endif %}
              {% endif %}
        sequence:
          - action: climate.turn_on
            target:
              entity_id: >
                {{ area_entities(room_area)
                   | select('match', '^climate\\.')
                   | list }}

mode: queued
